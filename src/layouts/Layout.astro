---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogPath?: string;
}

const { title, description, ogPath = '' } = Astro.props;
const canonical = `https://ttimemedia.org${ogPath}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>

<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:image" content="https://ttimemedia.org/share.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&display=swap" rel="stylesheet">
<script is:inline defer src="/_vercel/insights/script.js"></script>
</head>
<body>
<slot />
<script is:inline>
  const yr = document.getElementById('yr');
  if (yr) yr.textContent = new Date().getFullYear();
</script>
</body>
</html>
