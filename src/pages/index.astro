---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="T-Time Media — A media production company"
  description="T-Time Media is an independent media production company creating original and partner-driven work across culture, identity, lifestyle, and community."
  ogPath=""
>
  <Header home />

  <!-- ================= ABOUT ================= -->
  <section id="about">
    <div class="wrap">
      <h2>What this is</h2>
      <div class="two-col">
        <div>
          <p class="lede">T-Time Media is an independent media production company creating original and partner-driven work across culture, identity, lifestyle, and community.</p>
          <p class="fineprint">Founded by Dominic Anthony Pérignon.</p>
        </div>
        <div>
          <p>We produce original series, interviews, branded content, and social-first media — working across formats and platforms without losing sight of the people at the center of the story.</p>
          <p>T-Time Series, our flagship, is about transgender men and transmasculine people — our lives, our history, and how we get covered. That includes men who've medically transitioned and men who haven't, men who "pass" and men who don't, binary and nonbinary transmasculine people alike — T-Time Series isn't defining who counts.</p>

          <!-- Verified figure. Re-check before launch; swap freely. -->
          <div class="figure">
            <span class="big">In the 2024–25 U.S. television season, 7 of 33 transgender characters were trans men. None were gay trans men.</span>
            <cite>GLAAD, <em>Where We Are on TV</em>, 2024–25 season</cite>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= MEET THE CREATOR ================= -->
  <section id="creator">
    <div class="wrap">
      <h2>Meet the creator</h2>
      <div class="two-col">
        <div>
          <div class="creator-photo"><img src="/creator.jpg" alt="Dominic Anthony Pérignon, founder of T-Time Media"></div>
        </div>
        <div>
          <p class="creator-name">Dominic Anthony Pérignon</p>
          <p class="creator-role">Founder, T-Time Media · Journalist · Storyteller</p>
          <p>Dominic Anthony Pérignon is the founder and creative force behind T-Time Media, a production company built around culture, identity, lifestyle, and community. He's a journalist and storyteller who got his start covering the lived experiences of transgender men — work that grew into T-Time Media's slate of original series and partner projects. His work is rooted in the belief that the people at the center of a story deserve to be represented not just as subjects of debate, but as people with histories, experiences, voices, creativity, and stories worth documenting.</p>

          <div class="figure">
            <span class="big">"I started T-Time because trans men's stories were missing — from mainstream LGBTQ+ conversations, media coverage, even our own community spaces. I wanted to put us at the center: to document our history, amplify our voices, and create a place where trans men can finally see themselves reflected."</span>
            <cite>— Dominic, on why he started T-Time Series</cite>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= NEWSLETTER ================= -->
  <section id="newsletter">
    <div class="wrap">
      <h2>Newsletter</h2>
      <div class="two-col">
        <div>
          <p class="lede">Social platforms can disappear. Email doesn't.</p>
          <p class="fineprint">Stories, sourcing, and the parts that don't fit in a caption. Roughly monthly.</p>
        </div>
        <div>
          <div data-fs-success style="display: none; padding: 12px 16px; background: #d4edda; border: 1px solid #c3e6cb; border-radius: 2px; color: #155724; margin-bottom: 16px; font-size: 15px;">
            ✓ Thanks for subscribing! Check your email to confirm.
          </div>
          <div data-fs-error style="display: none; padding: 12px 16px; background: #f8d7da; border: 1px solid #f5c6cb; border-radius: 2px; color: #721c24; margin-bottom: 16px; font-size: 15px;"></div>

          <form id="newsletter-form" data-fs-frm>
            <div class="form-row">
              <input type="text" name="name" placeholder="What should I call you?" aria-label="Name" data-fs-field>
              <input type="email" name="email" placeholder="Email" aria-label="Email" required data-fs-field>
              <button class="btn" type="submit" data-fs-submit-btn>Subscribe</button>
            </div>
          </form>
          <p class="fineprint" style="margin-top:16px;">No spam. No list sharing, ever. Unsubscribe in one click.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PRESS ================= -->
  <section id="press">
    <div class="wrap">
      <h2>Press &amp; contact</h2>
      <p class="press-email"><a href="mailto:hello@ttimemedia.org">hello@ttimemedia.org</a></p>
      <div class="contact-grid">
        <div>
          <h3>Press &amp; interviews</h3>
          <p>Available for comment on trans men's representation in media, and on coverage practices.</p>
        </div>
        <div>
          <h3>Pitches &amp; collaboration</h3>
          <p>Story tips, guest segments, and partnership inquiries.</p>
        </div>
        <div>
          <h3>Corrections</h3>
          <p>If something here is wrong, tell me and I'll fix it and say what changed.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <!-- Formspree AJAX Integration - Newsletter Form -->
  <script is:inline>
    window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
    formspree('initForm', { formElement: '#newsletter-form', formId: 'xljroega', successRedirect: 'https://www.ttimemedia.org/subscribed' });
  </script>
  <script is:inline src="https://unpkg.com/@formspree/ajax@1" defer></script>
</Layout>
