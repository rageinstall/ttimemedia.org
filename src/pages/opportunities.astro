---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Opportunities — T-Time Media"
  description="Press credentials, event coverage, and open calls to work with T-Time Media."
  ogPath="/opportunities"
>
  <Header />

  <!-- ================= INTRO ================= -->
  <section id="opportunities">
    <div class="wrap">
      <h2>Opportunities</h2>
      <div class="two-col">
        <div>
          <p class="lede">Press credentials, event coverage, and open calls to work with us.</p>
        </div>
        <div>
          <p>As T-Time Media takes on more production work, this is where we'll post the gigs, credentials, and collaborations that come with it — and where you can see what we've already done.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= WHERE WE'VE BEEN ================= -->
  <section id="events">
    <div class="wrap">
      <h2>Where we've been</h2>
      <a class="event-feature" href="/press/comic-con">
        <span class="event-feature-text">
          <span class="seg">Press</span>
          <p class="t">Comic Con</p>
          <p class="d">T-Time Media's first event as press — 2026.</p>
          <span class="go">Read the recap →</span>
        </span>
        <span class="event-feature-photo">
          <img src="/images/comic-con/entrance.png" alt="The 'Welcome to L.A. Comic Con' sign above the crowded convention center atrium" />
        </span>
      </a>
    </div>
  </section>

  <style>
    .event-feature {
      display: grid;
      grid-template-columns: minmax(260px, 1fr) 2fr;
      border: 1px solid var(--line);
      text-decoration: none;
      color: inherit;
      transition: background .15s;
    }
    .event-feature:hover { background: var(--accent-soft); }
    .event-feature-text {
      padding: 26px 22px 30px;
      display: flex;
      flex-direction: column;
      min-height: 230px;
    }
    .event-feature-photo {
      overflow: hidden;
      border-left: 1px solid var(--line);
    }
    .event-feature-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    @media (max-width: 640px) {
      .event-feature { grid-template-columns: 1fr; }
      .event-feature-photo { border-left: 0; border-top: 1px solid var(--line); aspect-ratio: 16/9; }
    }
  </style>

  <!-- ================= OPEN OPPORTUNITIES ================= -->
  <section id="open">
    <div class="wrap">
      <h2>Open opportunities</h2>
      <div class="two-col">
        <div>
          <p class="lede">Nothing open right now.</p>
        </div>
        <div>
          <p>Check back here, or <a href="/#newsletter">subscribe to the newsletter</a> to hear when something opens up. Have a gig, event, or collaboration in mind for us? <a href="mailto:hello@ttimemedia.org">Get in touch</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
