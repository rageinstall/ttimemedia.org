---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Subscription Confirmed — T-Time Media"
  description="Thank you for subscribing to the T-Time Media newsletter."
  ogPath="/subscribed"
>
  <div class="success-container">
    <div class="success-box">
      <div class="success-icon">✓</div>

      <h1>Subscription Confirmed!</h1>

      <p class="subtitle">Thank you for subscribing to T-Time Media. You're now part of our community.</p>

      <div class="details">
        <p><strong>What's next?</strong></p>
        <p>Check your email for a confirmation message. You'll receive the next T-Time newsletter at the beginning of the next month—stories, sourcing, and the parts that don't fit in a caption.</p>
        <p style="font-size:14px;color:#5f5854;margin-top:16px;">No spam. No list sharing, ever. Unsubscribe anytime with one click.</p>
      </div>

      <a href="https://www.ttimemedia.org" class="cta">Return to T-Time</a>

      <div class="footer-link">
        <p>Questions? <a href="mailto:hello@ttimemedia.org">Email us</a> anytime.</p>
      </div>
    </div>
  </div>
</Layout>
