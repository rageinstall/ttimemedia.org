---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Partner Work — T-Time Media"
  description="Interviews, branded content, and social-first media, made with partners who want it done with care."
  ogPath="/partner-work"
>
  <Header />

  <!-- ================= PARTNER WORK ================= -->
  <section id="about">
    <div class="wrap">
      <h2>Partner work</h2>
      <p class="page-title">Branded &amp; partner projects</p>
      <p class="lede">Done with care, not just on-brand.</p>
      <div class="doc">
        <p>We work with brands, organizations, and creators who need production done well — a crew that understands culture, not just cameras. Every project is built around the people at the center of the story, not just the brand.</p>
        <ul>
          <li><strong>Branded campaigns:</strong> concept through delivery, for partners who want it done with care.</li>
          <li><strong>Interviews:</strong> co-produced conversations that go beyond the press line.</li>
          <li><strong>Social-first media:</strong> content built for how people actually watch, on the platforms where it lives.</li>
        </ul>
      </div>
      <a class="btn btn-accent" href="mailto:hello@ttimemedia.org">Work with us</a>
    </div>
  </section>

  <Footer />
</Layout>
