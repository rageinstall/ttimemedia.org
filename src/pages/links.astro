    @keyframes shine { 0%, 55% { left: -40%; } 100% { left: 130%; } }
    @keyframes glow { 0%, 100% { filter: drop-shadow(0 0 2px rgba(198, 244, 50, 0.25)); } 50% { filter: drop-shadow(0 0 16px rgba(198, 244, 50, 0.7)); } }
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.12); } }
    @media (prefers-reduced-motion: reduce) { .link { transition: none; } .link:hover { transform: none; } .glow, .glow .link.main::after, .tag { animation: none; } .glow { filter: drop-shadow(0 0 8px rgba(198, 244, 50, 0.45)); } }
