---
interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
---

<header>
  <div class="wrap masthead">
    <p class="kicker">Media · Apps · Stories</p>
    <h1 class="wordmark" aria-label="T-Time Media">T<span>-</span>TIME</h1>
    <p class="standfirst">Stories, media and apps, made with purpose.</p>
  </div>
  <div class="wrap">
    <nav class="header-nav">
      {!home && <a href="/">Home</a>}
      <a href="/be-in-it">Be In It</a>
      <a href="/opportunities">Opportunities</a>
    </nav>
  </div>
</header>
